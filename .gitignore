# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# maplibre worker, copied from node_modules by tools/sync-maplibre-worker.mjs
/public/maplibre/

# Overpass extracts for the rail-shape pipeline — regenerable, and ~96 MB of it.
# The pipeline's outputs (rail-segments.json, RailSegments.json, coverage.txt)
# are committed; these raw bbox dumps are not.
/tools/railshapes/cache/

# Xcode per-user UI state
*.xcuserstate
xcuserdata/

# atomic-write temp files from the rail-shape pipeline
*.json.tmp

# Public PostHog client key, committed on purpose so deploys need no secret
!.env.production
